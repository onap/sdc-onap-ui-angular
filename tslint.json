{
  "extends": [
    "tslint:recommended"
  ],
  "rules": {
    "trailing-comma": true,
    "callable-types": true,
    "class-name": false,
    "comment-format": false,
    "curly": {
      "severity": "warning"
    },
    "eofline": false,
    "forin": {
      "severity": "warning"
    },
    "import-spacing": true,
    "indent": false,
    "max-line-length": false,
    "member-access": false,
    "member-ordering": false,
    "no-arg": true,
    "no-bitwise": true,
    "no-console": {
      "severity": "warning",
      "options": [
        "debug",
        "info",
        "time",
        "timeEnd",
        "trace"
      ]
    },
    "no-construct": true,
    "no-debugger": true,
    "no-empty": {
      "severity": "warning"
    },
    "no-empty-interface": true,
    "no-eval": true,
    "no-inferrable-types": false,
    "no-shadowed-variable": {
      "severity": "warning"
    },
    "no-string-literal": {
      "severity": "warning"
    },
    "no-string-throw": true,
    "no-switch-case-fall-through": true,
    "no-trailing-whitespace": false,
    "no-unused-expression": [
      true,
      "allow-fast-null-checks"
    ],
    "no-var-keyword": {
      "severity": "warning"
    },
    "object-literal-sort-keys": false,
    "one-line": false,
    "prefer-const": {
      "severity": "warning"
    },
    "quotemark": false,
    "semicolon": false,
    "triple-equals": {
      "severity": "warning",
      "options": [
        "allow-null-check",
        "allow-undefined-check"
      ]
    },
    "typedef-whitespace": false,
    "variable-name": false,
    "whitespace": false,
    "ordered-imports": false,
    "object-literal-shorthand": false,
    "no-consecutive-blank-lines": false,
    "object-literal-key-quotes": false,
    "arrow-parens": false,
    "jsdoc-format": false,
    "interface-name": false,
    "align": false,
    "no-angle-bracket-type-assertion": false,
    "max-classes-per-file": false,
    "space-before-function-paren": false,
    "only-arrow-functions": false,
    "array-type": false,
    "ban-types": {
      "severity": "warning",
      "options": [
        [
          "Object"
        ],
        [
          "Function"
        ],
        [
          "Boolean"
        ],
        [
          "Number"
        ],
        [
          "String"
        ],
        [
          "Symbol"
        ]
      ]
    }
  }
}
