    "jest-specific-snapshot": "2.0.0",
    "jest-preset-angular": "7.1.1",
    "onap-ui-common": "1.4.0",
    "raw-loader": "1.0.0",
    "react-draggable": "4.4.3",
    "rimraf": "^2.6.2",
    "rxjs": "6.5.5",
    "sass": "~1.48.0",
