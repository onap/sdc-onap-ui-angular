{
  "name": "onap-ui-angular",
  "version": "6.0.0",
  "author": "d2",
  "private": false,
  "main": "dist/index.umd.js",
  "license": "Apache-2.0",
  "scripts": {
    "build": "npm run build:pre && npm run build:ngc && npm run build:umd",
    "build:pre": "rimraf dist",
    "build:ngc": "node_modules/.bin/ngc -p tsconfig-aot.json",
    "build:umd": "TS_NODE_PROJECT=tsconfig.webpack.json webpack --config webpack-umd.config.ts --mode production",
    "build:umd-dev": "TS_NODE_PROJECT=tsconfig.webpack.json webpack --config webpack-umd.config.ts --mode development",
    "build:scss": "sass --load-path=. --no-source-map src/assets/styles/style.scss dist/style.css",
    "storybook": "start-storybook -p 6007",
    "storybook:build": "node --unhandled-rejections=strict node_modules/@storybook/angular/bin/build.js -c .storybook -o .storybook-out",
    "lint:src": "node_modules/.bin/tslint 'src/angular/**/*.ts'",
    "lint:stories": "node_modules/.bin/tslint 'stories/**/*.ts'",
    "test": "jest --config jest.config.js",
    "test:watch": "jest --config jest.config.js --watch"
  },
  "devDependencies": {
    "@angular/animations": "8.2.14",
    "@angular/common": "8.2.14",
    "@angular/compiler": "8.2.14",
    "@angular/compiler-cli": "8.2.14",
    "@angular/core": "8.2.14",
    "@angular/forms": "8.2.14",
    "@angular/platform-browser": "8.2.14",
    "@angular/platform-browser-dynamic": "8.2.14",
    "@angular-devkit/build-angular": "0.803.29",
    "@storybook/addon-actions": "5.3.21",
    "@storybook/addon-backgrounds": "5.3.21",
    "@storybook/addon-knobs": "5.3.21",
    "@storybook/addon-links": "5.3.21",
    "@storybook/addon-notes": "5.3.21",
    "@storybook/addon-options": "5.3.21",
    "@storybook/addon-storyshots": "5.3.21",
    "@storybook/addon-storysource": "5.3.21",
    "@storybook/addons": "5.3.21",
    "@storybook/angular": "5.3.21",
    "@types/jest": "24.0.25",
    "@types/node": "9.6.2",
    "@types/webpack-env": "1.15.1",
    "angular2-template-loader": "0.6.2",
    "autoprefixer": "8.6.5",
